{
  "name": "dell-dw5821e-manager",
  "version": "1.0.4",
  "description": "Dell DW5821e Modem Manager — Premium Desktop UI",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder --win",
    "rebuild": "electron-rebuild"
  },
  "author": "Modem Manager",
  "license": "MIT",
  "devDependencies": {
    "@electron/rebuild": "^3.6.0",
    "electron": "^33.3.1",
    "electron-builder": "^25.0.0"
  },
  "dependencies": {
    "@serialport/parser-readline": "^12.0.0",
    "serialport": "^12.0.0"
  },
  "build": {
    "appId": "com.modem.dw5821e-manager",
    "productName": "DW5821e Modem Manager",
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "src/assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*"
    ]
  }
}
